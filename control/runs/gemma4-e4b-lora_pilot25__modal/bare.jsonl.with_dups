ing=jax_padding,\n        dimension_numbers=('NDHWC', 'DHWOI', 'NDHWC')\n    )\n    x = x + conv_bias.reshape(1, 1, 1, 1, -1)\n\n    # NDHWC -> NCDHW\n    x = jnp.transpose(x, (0, 4, 1, 2, 3))\n\n    # LayerNorm over last dimension\n    mean = jnp.mean(x, axis=-1, keepdims=True)\n    var = jnp.mean((x - mean) ** 2, axis=-1, keepdims=True)\n    x = (x - mean) / jnp.sqrt(var + eps)\n    x = x * ln_weight + ln_bias\n\n    # GELU + Scaling\n    x = jax.nn.gelu(x)\n    x = x * scaling_factor\n    return x\n\ndef workload_pallas(x, conv_weight, conv_bias, ln_weight, ln_bias):\n    \"\"\"Pallas kernel for ConvTranspose3d + LayerNorm + GELU + Scaling.\"\"\"\n    batch_size, d_in, h_in, w_in, channels = x.shape\n    k = 4\n    stride = 2\n    padding = 1\n    eps = 1e-5\n    scaling_factor = 1.0\n\n    # Transpose and flip kernel\n    x_ndhwc = jnp.transpose(x, (0, 2, 3, 4, 1))\n    kernel_dhwoi = jnp.transpose(conv_weight, (2, 3, 4, 1, 0))\n    kernel_flipped = jnp.flip(kernel_dhwoi, axis=(0, 1, 2))\n\n    # Dilate input\n    d_dilated = d_in + (d_in - 1) * (stride - 1)\n    h_dilated = h_in + (h_in - 1) * (stride - 1)\n    w_dilated = w_in + (w_in - 1) * (stride - 1)\n    x_dilated = jnp.zeros((batch_size, d_dilated, h_dilated, w_dilated, channels), dtype=x.dtype)\n    x_dilated = x_dilated.at[:, ::stride, ::stride, ::stride, :].set(x)\n\n    pad = k - 1 - padding\n    jax_padding = ((pad, pad), (pad, pad), (pad, pad))\n\n    # Pallas implementation of ConvTranspose3d\n    # We use a custom implementation based on the general dilated conv structure\n    # Since Pallas doesn't have a direct ConvTranspose3d, we implement the dilated conv\n    # which is equivalent to ConvTranspose3d with stride=2, kernel=4, padding=1.\n    # The output shape is (N, D_out, H_out, W_out, C_out)\n    # D_out = D_in * stride + (k - 2) - 2*padding = D_in * 2 + 2\n    # For D_in=16, D_out = 32 + 2 = 34.\n    # The reference uses lax.conv_general_dilated with window_strides=(1,1,1)\n    # which is 